# Copy this file to .env.local and fill in the values.

# Unique access code for the /admin data panel (no username/password).
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_CODE=

# Optional deploy hook to let the admin panel trigger a full rebuild/redeploy.
# DEPLOY_HOOK_URL=

# Public site URL for canonical URLs, sitemap and Open Graph tags (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://world.mayyur.com
